{
  "appId": "org.kcomms.desktop.evaluation",
  "productName": "K-Comms Evaluation",
  "asar": true,
  "directories": { "output": "artifacts" },
  "files": ["src/**", "web-dist/**", "desktop.config.json", "package.json"],
  "afterPack": "scripts/harden-binary.cjs",
  "artifactName": "K-Comms-unsigned-evaluation-${version}-${os}-${arch}.${ext}",
  "publish": null,
  "forceCodeSigning": false,
  "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "signAndEditExecutable": false },
  "nsis": { "oneClick": false, "perMachine": false, "allowElevation": false, "allowToChangeInstallationDirectory": false },
  "mac": { "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }], "identity": null, "hardenedRuntime": true, "entitlements": "entitlements.mac.plist", "entitlementsInherit": "entitlements.mac.plist", "extendInfo": { "NSCameraUsageDescription": "Use the camera only when you enable video in a K-Comms call.", "NSMicrophoneUsageDescription": "Use the microphone only when you enable audio in a K-Comms call." } },
  "linux": { "target": [{ "target": "AppImage", "arch": ["x64"] }, { "target": "deb", "arch": ["x64"] }], "category": "Network", "maintainer": "K-Comms contributors" }
}
