MIX_ENV=dev
PHX_HOST=localhost
PORT=4000
SECRET_KEY_BASE=6KCL3mQG1j2dQME5wy6R5A0j2xzx9azR6fCP5MwlENiB3IKd1k7A5QfP1QW5m3RF
DATABASE_URL=ecto://postgres:postgres@postgres/k_comms_dev
POOL_SIZE=10
K_COMMS_ROLE=all
ALLOW_BOOTSTRAP=true
# Instant rooms are fail-closed unless explicitly enabled and bound to one
# configured tenant. Request data can never select this tenant.
INSTANT_ROOMS_ENABLED=false
INSTANT_ROOM_TENANT_SLUG=k-comms-development
INSTANT_ROOM_GUEST_IDLE_TTL_SECONDS=3600
INSTANT_ROOM_REGISTERED_IDLE_TTL_SECONDS=86400
INSTANT_ROOM_PRESENCE_HEARTBEAT_SECONDS=30
INSTANT_ROOM_PRESENCE_LEASE_SECONDS=90
INSTANT_ROOM_RECONNECT_GRACE_SECONDS=90
INSTANT_ROOM_MAX_PARTICIPANTS=25
ACCESS_TOKEN_TTL_SECONDS=3600
SESSION_TTL_SECONDS=2592000
SESSION_ABSOLUTE_TTL_SECONDS=2592000
PUBLIC_APP_URL=http://localhost:5173
PASSWORD_RECOVERY_SIGNING_KEY=development-only-password-recovery-signing-key
PASSWORD_RECOVERY_TTL_SECONDS=1800
PASSWORD_RECOVERY_RETENTION_SECONDS=2592000
PASSWORD_RECOVERY_MIN_RESPONSE_MS=500
PASSWORD_RECOVERY_JITTER_MS=50
# Local-proof bootstrap only; console grants use a separate one-shot operator environment.
K_COMMS_ALLOW_BOOTSTRAP_PLATFORM_ROLE=false
K_COMMS_BOOTSTRAP_PLATFORM_ROLE=
K_COMMS_BOOTSTRAP_PLATFORM_ROLE_TTL_SECONDS=28800
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HSTS_ENABLED=false
CSP_CONNECT_SOURCES='self' http://localhost:4000 ws://localhost:4000 http://localhost:9000 ws://127.0.0.1:7880
# Local same-host audio/video media plane. The AUDIO_* names are retained for
# compatibility and govern both media kinds. Production must use an externally
# managed WSS LiveKit origin and externally managed API credentials.
AUDIO_PROVIDER_MODE=livekit
LIVEKIT_SERVER_URL=ws://127.0.0.1:7880
LIVEKIT_API_URL=http://livekit:7880
LIVEKIT_API_KEY=kcomms-local-api-key
LIVEKIT_API_SECRET=kcomms-local-api-secret-not-for-prod
AUDIO_TOKEN_TTL_SECONDS=300
# Optional PSTN control plane; enabling requires configured SIP trunks and DIDs.
TELEPHONY_PROVIDER_MODE=disabled
TELEPHONY_RING_TIMEOUT_SECONDS=45
TELEPHONY_MAX_DURATION_SECONDS=1800
# Repeat idempotent participant eviction for at least long enough to outlive a
# cached token; failures keep retrying after this horizon. Production allows
# 660-1800 seconds; 660 is the baseline.
AUDIO_PARTICIPANT_EVICTION_ENFORCEMENT_SECONDS=660
# ICE relay. Without TURN, a participant behind a symmetric NAT or a
# UDP-blocking corporate firewall cannot establish media at all: the call fails
# rather than degrades. Both lists are comma-separated and empty by default,
# which is the portable single-host behaviour.
#
# TURN_URLS must use turns: in any promoted environment; plaintext turn: is
# accepted only behind the local-development adapter gate. Setting TURN_URLS
# without TURN_STATIC_AUTH_SECRET fails startup. The secret is the coturn
# `static-auth-secret`; the browser only ever receives a short-lived derived
# credential, never this value.
STUN_URLS=
TURN_URLS=
TURN_STATIC_AUTH_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_SIGNAL_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882
MINIO_ROOT_USER=kcomms
MINIO_ROOT_PASSWORD=change-this-local-password
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000
S3_PUBLIC_HOST=localhost
S3_PUBLIC_PORT=9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_INTERNAL_SCHEME=http
S3_INTERNAL_HOST=minio
S3_INTERNAL_PORT=9000
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_BUCKET=k-comms-dev
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=kcomms
S3_SECRET_ACCESS_KEY=change-this-local-password
# Upload URLs need a window long enough to transfer the object. Download URLs
# are redirected to immediately and land in browser history, so they are kept
# short; the download value is additionally capped by S3_URL_TTL_SECONDS.
S3_URL_TTL_SECONDS=900
S3_DOWNLOAD_URL_TTL_SECONDS=120
ALLOW_DEVELOPMENT_ADAPTERS=true
NOTIFICATION_PROVIDER_MODE=log
NOTIFICATION_PROVIDER_ENDPOINT=
NOTIFICATION_PROVIDER_TOKEN=
NOTIFICATION_PROVIDER_NAME=local-log
NOTIFICATION_PROVIDER_ALLOWED_HOSTS=
NOTIFICATION_PROVIDER_TIMEOUT_MS=10000
ATTACHMENT_SCANNER_MODE=allow_all
ATTACHMENT_SCANNER_ENDPOINT=
ATTACHMENT_SCANNER_TOKEN=
ATTACHMENT_SCANNER_PROVIDER_NAME=local-allow-all
ATTACHMENT_SCANNER_ALLOWED_HOSTS=
ATTACHMENT_SCANNER_TIMEOUT_MS=30000
WEBHOOK_PROVIDER_MODE=log
WEBHOOK_ALLOWED_HOSTS=webhook.local
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_SECRET_ENCRYPTION_KEY=development-only-webhook-key-32b
WEBHOOK_SECRET_ENCRYPTION_KEY_ID=primary
# Optional rotation keyring: primary:<base64-32-byte-key>,previous:<base64-32-byte-key>
WEBHOOK_SECRET_ENCRYPTION_KEYS=
# Browser subscriptions are encrypted with a dedicated key. The public VAPID key
# must match the private key held only by the configured notification provider.
PUSH_SUBSCRIPTION_ENCRYPTION_KEY=push-subscription-test-key-32byt
PUSH_SUBSCRIPTION_ENCRYPTION_KEY_ID=primary
# Optional rotation keyring: primary:<base64-32-byte-key>,previous:<base64-32-byte-key>
PUSH_SUBSCRIPTION_ENCRYPTION_KEYS=
WEB_PUSH_VAPID_PUBLIC_KEY=BIdD6B2jZb5v7fwxbXdnpkOpJrsegpqJbZPPoWb3dI6m5jpkSTB_ZekUrAdKVXR4f_s5nU89TSZlDOxcTHJxAFo
METRICS_ALLOW_UNAUTHENTICATED=true
METRICS_BEARER_TOKEN=development-metrics-token-32chars
SEED_DEMO_DATA=false
SEED_TENANT_SLUG=k-comms-development
SEED_OWNER_EMAIL=owner@k-comms.local
SEED_OWNER_PASSWORD=change-this-demo-password

# Optional enterprise identity. Keep sign in off until the actual IdP is qualified.
# Use an independent random 32-byte Base64 key for MFA/SSO secrets. Do not reuse
# endpoint, recovery, webhook, push or PBX credentials. Empty leaves MFA unconfigured.
IDENTITY_SECRET_ENCRYPTION_KEY=
IDENTITY_SECRET_ENCRYPTION_KEY_ID=primary
# Optional rotation: primary:<base64-32-byte-key>,previous:<base64-32-byte-key>.
# Alternatively use KEYS_JSON={"primary":"<base64-32-byte-key>"}; do not set both.
IDENTITY_SECRET_ENCRYPTION_KEYS=
IDENTITY_SECRET_ENCRYPTION_KEYS_JSON=
# Console-only break-glass credential; no public HTTP endpoint accepts this value.
IDENTITY_BREAK_GLASS_SECRET=
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_ALLOWED_REDIRECT_URIS_JSON=[]
# Explicit comma-separated IdP assurance values; no implicit MFA claim is accepted.
OIDC_REQUIRED_ACR_VALUES=
OIDC_SCIM_SUBJECT_MAPPING=false

# Optional advanced telephone controls. No carrier or PBX is auto-provisioned.
TELEPHONY_CONTROL_PROVIDER=livekit
TELEPHONY_TRANSFER_ENABLED=false
TELEPHONY_TRANSFER_DESTINATION_PREFIXES=
TELEPHONY_PBX_ENABLED=false
TELEPHONY_PBX_QUALIFIED=false
TELEPHONY_PBX_API_URL=
TELEPHONY_PBX_USERNAME=
TELEPHONY_PBX_PASSWORD=
TELEPHONY_PBX_ENDPOINT=
TELEPHONY_PBX_APPLICATION=k-comms
TELEPHONY_PBX_DESTINATION_PREFIXES=
TELEPHONY_PBX_WEBHOOK_SECRET=
TELEPHONY_VOICEMAIL_STORAGE_QUALIFIED=false

# Capture is off until privacy review, provider qualification and exact tenant
# UUIDs are recorded. Set DIRECT_AUDIO_P2P_ENABLED=false before enabling capture.
MEETING_ARTIFACT_PRIVACY_APPROVED=false
MEETING_ARTIFACT_PROVIDER_QUALIFIED=false
MEETING_ARTIFACT_ENABLED_TENANT_IDS=
MEETING_ARTIFACTS_ENABLED=false
LIVEKIT_EGRESS_ENABLED=false
ARTIFACT_TRANSCRIPTION_ENABLED=false
ARTIFACT_TRANSCRIPTION_QUALIFIED=false
ARTIFACT_TRANSCRIPTION_ORIGIN=
ARTIFACT_TRANSCRIPTION_MAX_MEDIA_BYTES=26214400
ARTIFACT_TRANSCRIPTION_MAX_RESPONSE_BYTES=1048576
ARTIFACT_TRANSCRIPTION_TIMEOUT_MS=30000
ARTIFACT_TRANSCRIPTION_MODEL=whisper-1
ARTIFACT_TRANSCRIPTION_LANGUAGE=
# Optional secret *_FILE inputs select private regular files mounted directly in
# /run/secrets. Empty inline and file values are ignored; never set both forms.
# This environment file does not create or mount those files.
IDENTITY_SECRET_ENCRYPTION_KEY_FILE=
IDENTITY_SECRET_ENCRYPTION_KEYS_FILE=
IDENTITY_SECRET_ENCRYPTION_KEYS_JSON_FILE=
IDENTITY_BREAK_GLASS_SECRET_FILE=
OIDC_CLIENT_SECRET_FILE=
TELEPHONY_PBX_USERNAME_FILE=
TELEPHONY_PBX_PASSWORD_FILE=
TELEPHONY_PBX_WEBHOOK_SECRET_FILE=
# Optional dedicated deletion-history cursor signing key: at least 32 random bytes.
# Keep the same secret on all app replicas; rotating it expires existing 1h snapshots.
# Empty leaves history unavailable and does not affect deletion execution.
GOV_HISTORY_CURSOR_KEY=

# Optional hosted Calendar export; providers are off by default.
# Use dedicated 32-byte Base64 keys, never identity/push/webhook/history keys.
CALENDAR_ENCRYPTION_KEY_ID=primary
CALENDAR_SECRET_ENCRYPTION_KEYS=
CALENDAR_GOOGLE_ENABLED=false
CALENDAR_GOOGLE_CLIENT_ID=
CALENDAR_GOOGLE_CLIENT_SECRET=
CALENDAR_MICROSOFT_ENABLED=false
CALENDAR_MICROSOFT_CLIENT_ID=
CALENDAR_MICROSOFT_CLIENT_SECRET=
CALENDAR_MICROSOFT_TENANT_ID=
# Client secrets and keyring support mutually exclusive _FILE bindings under /run/secrets.
# Redirects are fixed to PUBLIC_APP_URL origin /api/v1/calendar/oauth/{provider}/callback.
CALENDAR_SECRET_ENCRYPTION_KEYS_FILE=
CALENDAR_GOOGLE_CLIENT_SECRET_FILE=
CALENDAR_MICROSOFT_CLIENT_SECRET_FILE=
