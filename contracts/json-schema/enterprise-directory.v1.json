{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://k-comms.example.test/contracts/enterprise-directory.v1.json",
  "title": "SCIM v2 scoped directory response",
  "description": "Closed SCIM resource, bounded list, configuration and lifecycle-error DTOs. Empty User and Group lists share the SCIM ListResponse wire envelope.",
  "anyOf": [
    {
      "$ref": "#/$defs/ScimUser"
    },
    {
      "$ref": "#/$defs/ScimGroup"
    },
    {
      "$ref": "#/$defs/ScimUserList"
    },
    {
      "$ref": "#/$defs/ScimGroupList"
    },
    {
      "$ref": "#/$defs/ScimProviderConfig"
    },
    {
      "$ref": "#/$defs/ScimError"
    }
  ],
  "$defs": {
    "ScimUser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemas",
        "id",
        "externalId",
        "userName",
        "displayName",
        "active",
        "meta"
      ],
      "properties": {
        "schemas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "minItems": 1,
          "maxItems": 2
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "externalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320,
          "format": "email"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "active": {
          "type": "boolean"
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resourceType",
            "created",
            "lastModified",
            "version"
          ],
          "properties": {
            "resourceType": {
              "type": "string",
              "enum": [
                "User",
                "Group"
              ]
            },
            "created": {
              "type": "string",
              "format": "date-time"
            },
            "lastModified": {
              "type": "string",
              "format": "date-time"
            },
            "version": {
              "type": "string",
              "minLength": 5,
              "maxLength": 30,
              "pattern": "^W/\"[1-9][0-9]*\"$"
            }
          }
        }
      }
    },
    "ScimGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemas",
        "id",
        "externalId",
        "displayName",
        "members",
        "meta"
      ],
      "properties": {
        "schemas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "minItems": 1,
          "maxItems": 1
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "externalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resourceType",
            "created",
            "lastModified",
            "version"
          ],
          "properties": {
            "resourceType": {
              "type": "string",
              "enum": [
                "User",
                "Group"
              ]
            },
            "created": {
              "type": "string",
              "format": "date-time"
            },
            "lastModified": {
              "type": "string",
              "format": "date-time"
            },
            "version": {
              "type": "string",
              "minLength": 5,
              "maxLength": 30,
              "pattern": "^W/\"[1-9][0-9]*\"$"
            }
          }
        }
      }
    },
    "ScimUserList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemas",
        "totalResults",
        "startIndex",
        "itemsPerPage",
        "Resources"
      ],
      "properties": {
        "schemas": {
          "type": "array",
          "items": {
            "const": "urn:ietf:params:scim:api:messages:2.0:ListResponse"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "totalResults": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "startIndex": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "itemsPerPage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "Resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScimUser"
          },
          "minItems": 0,
          "maxItems": 100
        }
      }
    },
    "ScimGroupList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemas",
        "totalResults",
        "startIndex",
        "itemsPerPage",
        "Resources"
      ],
      "properties": {
        "schemas": {
          "type": "array",
          "items": {
            "const": "urn:ietf:params:scim:api:messages:2.0:ListResponse"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "totalResults": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "startIndex": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "itemsPerPage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "Resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScimGroup"
          },
          "minItems": 0,
          "maxItems": 100
        }
      }
    },
    "ScimProviderConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemas",
        "patch",
        "bulk",
        "filter",
        "changePassword",
        "sort",
        "etag",
        "authenticationSchemes"
      ],
      "properties": {
        "schemas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "minItems": 1,
          "maxItems": 1
        },
        "patch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supported"
          ],
          "properties": {
            "supported": {
              "const": true
            }
          }
        },
        "bulk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supported"
          ],
          "properties": {
            "supported": {
              "const": false
            }
          }
        },
        "filter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supported",
            "maxResults"
          ],
          "properties": {
            "supported": {
              "const": true
            },
            "maxResults": {
              "const": 100
            }
          }
        },
        "changePassword": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supported"
          ],
          "properties": {
            "supported": {
              "const": false
            }
          }
        },
        "sort": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supported"
          ],
          "properties": {
            "supported": {
              "const": false
            }
          }
        },
        "etag": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "supported"
          ],
          "properties": {
            "supported": {
              "const": true
            }
          }
        },
        "authenticationSchemes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "name",
              "description",
              "primary"
            ],
            "properties": {
              "type": {
                "const": "oauthbearertoken"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "primary": {
                "const": true
              }
            }
          },
          "minItems": 1,
          "maxItems": 1
        }
      }
    },
    "ScimError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemas",
        "status",
        "detail"
      ],
      "properties": {
        "schemas": {
          "type": "array",
          "items": {
            "const": "urn:ietf:params:scim:api:messages:2.0:Error"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "status": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3,
          "pattern": "^[45][0-9]{2}$"
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    }
  }
}
