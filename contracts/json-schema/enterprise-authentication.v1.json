{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://k-comms.example.test/contracts/enterprise-authentication.v1.json",
  "title": "enterprise-authentication.v1.json",
  "oneOf": [
    {
      "$ref": "#/$defs/MfaChallenge"
    },
    {
      "$ref": "#/$defs/MfaSignInRequest"
    },
    {
      "$ref": "#/$defs/OidcStartRequest"
    },
    {
      "$ref": "#/$defs/OidcCallbackRequest"
    }
  ],
  "$defs": {
    "MfaChallenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mfa_required",
        "challenge_token",
        "expires_in"
      ],
      "properties": {
        "mfa_required": {
          "const": true
        },
        "challenge_token": {
          "type": "string",
          "minLength": 32,
          "maxLength": 256
        },
        "expires_in": {
          "const": 300
        }
      }
    },
    "MfaSignInRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge_token",
        "code"
      ],
      "properties": {
        "challenge_token": {
          "type": "string",
          "minLength": 32,
          "maxLength": 256
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "OidcStartRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_slug"
      ],
      "properties": {
        "tenant_slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "return_to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Reviewed same-origin member destination; unsafe input falls back to /app."
        }
      }
    },
    "OidcCallbackRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "state"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "state": {
          "type": "string",
          "minLength": 32,
          "maxLength": 256
        }
      }
    }
  }
}
