{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://k-comms.example.test/contracts/meeting-lifecycle.v1.json",
  "title": "meeting-lifecycle.v1.json",
  "oneOf": [
    {
      "$ref": "#/$defs/Meeting"
    }
  ],
  "$defs": {
    "Meeting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "timezone",
        "local_start",
        "duration_minutes",
        "recurrence",
        "reminder_minutes",
        "host_policy",
        "id",
        "conversation_id",
        "host_user_id",
        "version",
        "status",
        "occurrences",
        "can_manage"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "UTF-8 at most800 bytes."
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "local_start": {
          "type": "string",
          "minLength": 19,
          "maxLength": 26,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?$"
        },
        "duration_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 480
        },
        "recurrence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "frequency",
            "interval",
            "count"
          ],
          "properties": {
            "frequency": {
              "type": "string",
              "enum": [
                "none",
                "daily",
                "weekly"
              ]
            },
            "interval": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 52
            }
          }
        },
        "reminder_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10080
        },
        "host_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "allow_guests",
            "join_before_host"
          ],
          "properties": {
            "allow_guests": {
              "type": "boolean"
            },
            "join_before_host": {
              "type": "boolean"
            }
          }
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "conversation_id": {
          "type": "string",
          "format": "uuid"
        },
        "host_user_id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "status": {
          "type": "string",
          "enum": [
            "scheduled",
            "cancelled"
          ]
        },
        "occurrences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MeetingOccurrence"
          },
          "minItems": 1,
          "maxItems": 52
        },
        "can_manage": {
          "type": "boolean"
        }
      }
    },
    "MeetingOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sequence",
        "starts_at",
        "ends_at",
        "status",
        "call_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52
        },
        "starts_at": {
          "type": "string",
          "format": "date-time"
        },
        "ends_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "scheduled",
            "cancelled"
          ]
        },
        "call_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    }
  }
}
