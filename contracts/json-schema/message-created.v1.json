{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://k-comms.invalid/schemas/message-created.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tenant_id",
    "conversation_id",
    "conversation_sequence",
    "sender_user_id",
    "sender_device_id",
    "client_message_id",
    "reply_to_message_id",
    "thread_root_message_id",
    "thread_reply_count",
    "mentioned_user_ids",
    "body",
    "metadata",
    "status",
    "edited_at",
    "deleted_at",
    "inserted_at",
    "attachments",
    "reactions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "conversation_id": {
      "type": "string",
      "format": "uuid"
    },
    "conversation_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "sender_user_id": {
      "type": "string",
      "format": "uuid"
    },
    "sender_device_id": {
      "type": "string",
      "format": "uuid"
    },
    "client_message_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "reply_to_message_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "thread_root_message_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "thread_reply_count": {
      "type": "integer",
      "minimum": 0
    },
    "mentioned_user_ids": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "body": {
      "type": ["string", "null"]
    },
    "status": {
      "enum": ["active", "deleted", "moderated"]
    },
    "metadata": {
      "type": "object",
      "maxProperties": 32,
      "properties": {
        "links": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url"],
            "properties": {
              "url": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048},
              "label": {"type": "string", "minLength": 1, "maxLength": 160}
            }
          }
        },
        "whiteboard_reference": {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            {"required": ["element_ids"]},
            {"required": ["region"]}
          ],
          "properties": {
            "element_ids": {
              "type": "array",
              "maxItems": 20,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 8, "maxLength": 128}
            },
            "board_sequence": {"type": "integer", "minimum": 0},
            "label": {"type": "string", "minLength": 1, "maxLength": 120},
            "region": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y", "width", "height"],
              "properties": {
                "x": {"type": "number", "minimum": -10000000, "maximum": 10000000},
                "y": {"type": "number", "minimum": -10000000, "maximum": 10000000},
                "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000000},
                "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000000}
              }
            }
          }
        }
      }
    },
    "edited_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "deleted_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "inserted_at": {
      "type": "string",
      "format": "date-time"
    },
    "attachments": {
      "type": "array",
      "items": {"type": "object"}
    },
    "reactions": {
      "type": "array",
      "items": {"type": "object"}
    }
  }
}
