# Import through the selected external secret controller. Never apply this file
# with placeholder values or commit a populated copy.
NOTIFICATION_PROVIDER_TOKEN=CHANGE_ME
# The VAPID private key belongs to the notification provider and is never mounted into K-Comms.
ATTACHMENT_SCANNER_TOKEN=CHANGE_ME
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES

# Optional Calendar keys and delegated OAuth client secrets. Keep providers off until qualified.
# Keyring format: key_id:Base64-of-dedicated-32-random-bytes (1 to 8 entries).
CALENDAR_SECRET_ENCRYPTION_KEYS=
CALENDAR_GOOGLE_CLIENT_SECRET=
CALENDAR_MICROSOFT_CLIENT_SECRET=
