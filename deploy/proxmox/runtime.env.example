# Copy to /etc/k-comms/runtime.env, replace every CHANGE_ME value, and chmod 0600.
# Never commit the populated file.
POSTGRES_USER=kcomms
POSTGRES_PASSWORD=CHANGE_ME_HEX_32_BYTES
POSTGRES_DB=k_comms_release
DATABASE_URL=ecto://kcomms:CHANGE_ME_HEX_32_BYTES@postgres/k_comms_release
POOL_SIZE=10

SECRET_KEY_BASE=CHANGE_ME_BASE64_64_BYTES
PASSWORD_RECOVERY_SIGNING_KEY=CHANGE_ME_BASE64_32_BYTES
WEBHOOK_SECRET_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
WEBHOOK_SECRET_ENCRYPTION_KEY_ID=primary
PUSH_SUBSCRIPTION_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
PUSH_SUBSCRIPTION_ENCRYPTION_KEY_ID=primary
METRICS_BEARER_TOKEN=CHANGE_ME_HEX_32_BYTES

PUBLIC_APP_URL=CHANGE_ME
PHX_HOST=CHANGE_ME
PORT=4000
K_COMMS_RELEASE_HOST=CHANGE_ME
K_COMMS_LOCAL_RELEASE_HOST=CHANGE_ME
K_COMMS_RELEASE_EXPOSURE_MODE=
K_COMMS_TRUSTED_EDGE_CONFIRMATION=
CORS_ORIGINS=CHANGE_ME
CSP_CONNECT_SOURCES=CHANGE_ME
HSTS_ENABLED=false
TRUSTED_PROXY_CIDRS=

ALLOW_BOOTSTRAP=false
INSTANT_ROOMS_ENABLED=true
IMMERSIVE_MODE_ENABLED=false
INSTANT_ROOM_TENANT_SLUG=k-comms-staging
INSTANT_ROOM_GUEST_IDLE_TTL_SECONDS=3600
INSTANT_ROOM_REGISTERED_IDLE_TTL_SECONDS=86400
INSTANT_ROOM_PRESENCE_HEARTBEAT_SECONDS=30
INSTANT_ROOM_PRESENCE_LEASE_SECONDS=90
INSTANT_ROOM_RECONNECT_GRACE_SECONDS=90
INSTANT_ROOM_MAX_PARTICIPANTS=25
ACCESS_TOKEN_TTL_SECONDS=3600
SESSION_TTL_SECONDS=2592000
SESSION_ABSOLUTE_TTL_SECONDS=2592000
PASSWORD_RECOVERY_TTL_SECONDS=1800
PASSWORD_RECOVERY_RETENTION_SECONDS=2592000
PASSWORD_RECOVERY_MIN_RESPONSE_MS=500
PASSWORD_RECOVERY_JITTER_MS=50

ALLOW_DEVELOPMENT_ADAPTERS=true
NOTIFICATION_PROVIDER_MODE=log
NOTIFICATION_PROVIDER_NAME=proxmox-release-log
ATTACHMENT_SCANNER_MODE=allow_all
ATTACHMENT_SCANNER_PROVIDER_NAME=proxmox-release-allow-all
WEBHOOK_PROVIDER_MODE=log
WEBHOOK_ALLOWED_HOSTS=webhook.local
WEB_PUSH_VAPID_PUBLIC_KEY=BIdD6B2jZb5v7fwxbXdnpkOpJrsegpqJbZPPoWb3dI6m5jpkSTB_ZekUrAdKVXR4f_s5nU89TSZlDOxcTHJxAFo
METRICS_ALLOW_UNAUTHENTICATED=false

LIVEKIT_SERVER_URL=CHANGE_ME
LIVEKIT_API_URL=http://livekit:7880
LIVEKIT_API_KEY=CHANGE_ME_HEX_16_BYTES
LIVEKIT_API_SECRET=CHANGE_ME_HEX_32_BYTES
LIVEKIT_KEYS=CHANGE_ME_HEX_16_BYTES: CHANGE_ME_HEX_32_BYTES
K_COMMS_LIVEKIT_TOPOLOGY=local_sidecar
K_COMMS_MANAGED_LIVEKIT_CONFIRMATION=
AUDIO_PROVIDER_MODE=livekit
AUDIO_TOKEN_TTL_SECONDS=300
AUDIO_PARTICIPANT_EVICTION_ENFORCEMENT_SECONDS=660
# Enable only after a carrier, isolated SIP dispatch, and tenant number are qualified.
# Telephony reuses the protected LiveKit API credentials above.
TELEPHONY_PROVIDER_MODE=disabled
TELEPHONY_RING_TIMEOUT_SECONDS=45
TELEPHONY_MAX_DURATION_SECONDS=1800
DIRECT_AUDIO_P2P_ENABLED=true
DIRECT_AUDIO_STUN_URLS=stun:stun.cloudflare.com:3478

MINIO_ROOT_USER=kcomms
MINIO_ROOT_PASSWORD=CHANGE_ME_HEX_32_BYTES
MINIO_API_CORS_ALLOW_ORIGIN=CHANGE_ME
S3_PUBLIC_ENDPOINT=CHANGE_ME
S3_INTERNAL_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=kcomms
S3_SECRET_ACCESS_KEY=CHANGE_ME_HEX_32_BYTES
S3_BUCKET=k-comms-release
S3_REGION=us-east-1

BOOTSTRAP_TENANT_NAME=K-Comms Staging
BOOTSTRAP_TENANT_SLUG=k-comms-staging
BOOTSTRAP_OWNER_DISPLAY_NAME=Staging Owner
BOOTSTRAP_OWNER_EMAIL=staging-owner@k-comms.invalid
BOOTSTRAP_OWNER_PASSWORD=CHANGE_ME_BASE64URL_24_BYTES

# Optional enterprise identity. Keep sign in off until the actual IdP is qualified.
# Use an independent random 32-byte Base64 key for MFA/SSO secrets. Do not reuse
# endpoint, recovery, webhook, push or PBX credentials. Empty leaves MFA unconfigured.
IDENTITY_SECRET_ENCRYPTION_KEY=
IDENTITY_SECRET_ENCRYPTION_KEY_ID=primary
# Optional rotation: primary:<base64-32-byte-key>,previous:<base64-32-byte-key>.
# Alternatively use KEYS_JSON={"primary":"<base64-32-byte-key>"}; do not set both.
IDENTITY_SECRET_ENCRYPTION_KEYS=
IDENTITY_SECRET_ENCRYPTION_KEYS_JSON=
# Console-only break-glass credential; no public HTTP endpoint accepts this value.
IDENTITY_BREAK_GLASS_SECRET=
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_ALLOWED_REDIRECT_URIS_JSON=[]
# Explicit comma-separated IdP assurance values; no implicit MFA claim is accepted.
OIDC_REQUIRED_ACR_VALUES=
OIDC_SCIM_SUBJECT_MAPPING=false

# Optional advanced telephone controls. No carrier or PBX is auto-provisioned.
TELEPHONY_CONTROL_PROVIDER=livekit
TELEPHONY_TRANSFER_ENABLED=false
TELEPHONY_TRANSFER_DESTINATION_PREFIXES=
TELEPHONY_PBX_ENABLED=false
TELEPHONY_PBX_QUALIFIED=false
TELEPHONY_PBX_API_URL=
TELEPHONY_PBX_USERNAME=
TELEPHONY_PBX_PASSWORD=
TELEPHONY_PBX_ENDPOINT=
TELEPHONY_PBX_APPLICATION=k-comms
TELEPHONY_PBX_DESTINATION_PREFIXES=
TELEPHONY_PBX_WEBHOOK_SECRET=
TELEPHONY_VOICEMAIL_STORAGE_QUALIFIED=false

# Capture is off until privacy review, provider qualification and exact tenant
# UUIDs are recorded. Set DIRECT_AUDIO_P2P_ENABLED=false before enabling capture.
MEETING_ARTIFACT_PRIVACY_APPROVED=false
MEETING_ARTIFACT_PROVIDER_QUALIFIED=false
MEETING_ARTIFACT_ENABLED_TENANT_IDS=
MEETING_ARTIFACTS_ENABLED=false
LIVEKIT_EGRESS_ENABLED=false
ARTIFACT_TRANSCRIPTION_ENABLED=false
ARTIFACT_TRANSCRIPTION_QUALIFIED=false
ARTIFACT_TRANSCRIPTION_ORIGIN=
ARTIFACT_TRANSCRIPTION_MAX_MEDIA_BYTES=26214400
ARTIFACT_TRANSCRIPTION_MAX_RESPONSE_BYTES=1048576
ARTIFACT_TRANSCRIPTION_TIMEOUT_MS=30000
ARTIFACT_TRANSCRIPTION_MODEL=whisper-1
ARTIFACT_TRANSCRIPTION_LANGUAGE=
# Optional secret *_FILE inputs select private regular files mounted directly in
# /run/secrets. Empty inline and file values are ignored; never set both forms.
# This environment file does not create or mount those files.
IDENTITY_SECRET_ENCRYPTION_KEY_FILE=
IDENTITY_SECRET_ENCRYPTION_KEYS_FILE=
IDENTITY_SECRET_ENCRYPTION_KEYS_JSON_FILE=
IDENTITY_BREAK_GLASS_SECRET_FILE=
OIDC_CLIENT_SECRET_FILE=
TELEPHONY_PBX_USERNAME_FILE=
TELEPHONY_PBX_PASSWORD_FILE=
TELEPHONY_PBX_WEBHOOK_SECRET_FILE=
# Optional dedicated deletion-history cursor signing key: at least 32 random bytes.
# Keep the same secret on all app replicas; rotating it expires existing 1h snapshots.
# Empty leaves history unavailable and does not affect deletion execution.
GOV_HISTORY_CURSOR_KEY=

# Optional hosted Calendar export: enabled only after operator/provider qualification.
CALENDAR_ENCRYPTION_KEY_ID=primary
CALENDAR_SECRET_ENCRYPTION_KEYS=
CALENDAR_SECRET_ENCRYPTION_KEYS_FILE=
CALENDAR_GOOGLE_ENABLED=false
CALENDAR_GOOGLE_CLIENT_ID=
CALENDAR_GOOGLE_CLIENT_SECRET=
CALENDAR_GOOGLE_CLIENT_SECRET_FILE=
CALENDAR_MICROSOFT_ENABLED=false
CALENDAR_MICROSOFT_CLIENT_ID=
CALENDAR_MICROSOFT_CLIENT_SECRET=
CALENDAR_MICROSOFT_CLIENT_SECRET_FILE=
CALENDAR_MICROSOFT_TENANT_ID=
