[Unit]
Description=K-Comms application
Requires=k-comms-postgres.service k-comms-minio.service k-comms-livekit.service
After=k-comms-postgres.service k-comms-minio.service k-comms-livekit.service

[Container]
ContainerName=k-comms-app
Image=@@IMAGE_REF@@
Network=k-comms.network
NetworkAlias=app
EnvironmentFile=/etc/k-comms/runtime.env
EnvironmentFile=/etc/k-comms/release.env
Environment=K_COMMS_ROLE=all
Environment=K_COMMS_RUNTIME_PURPOSE=application
Environment=K_COMMS_LOCAL_RELEASE=true
Environment=PORT=4000
PublishPort=@@BIND_ADDRESS@@:4188:4000/tcp
ReadOnly=true
Tmpfs=/tmp:rw,noexec,nosuid,size=134217728
DropCapability=all
NoNewPrivileges=true
HealthCmd=curl --fail --silent --show-error http://127.0.0.1:4000/health/ready
HealthInterval=5s
HealthTimeout=5s
HealthRetries=30
HealthStartPeriod=20s
Notify=healthy
Label=io.k-comms.managed=true
Label=io.k-comms.role=application
Label=io.k-comms.revision=@@REVISION@@
Label=io.k-comms.rollback-capabilities=guest_identity_v1,guest_admission_expiry_worker_v1,instant_room_lifecycle_v1,instant_room_presence_lease_v1,instant_room_expiry_worker_v1,conversation_only_human_v1

[Service]
Restart=always
TimeoutStartSec=240
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
