{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://k-comms.example/schemas/usability-study-v3-v4.json",
  "title": "K-Comms formal usability study evidence",
  "description": "Privacy-preserving structural contract for version 3 signed-in usability evidence and version 4 evidence that also covers the public instant-room journey. The score_usability_study.mjs validator is authoritative for cross-field task, action-count, participant, date, version, and release-gate semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_revision",
    "environment",
    "study_started_on",
    "study_completed_on",
    "security_regression",
    "authorization_regression",
    "tenant_isolation_regression",
    "durability_regression",
    "staging_gates_pass",
    "manual_accessibility",
    "accessibility_findings",
    "approver_receipt",
    "action_count_receipts",
    "sessions"
  ],
  "properties": {
    "schema_version": { "enum": [3, 4] },
    "release_revision": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "environment": { "type": "string", "minLength": 1, "maxLength": 120 },
    "study_started_on": { "type": "string", "format": "date" },
    "study_completed_on": { "type": "string", "format": "date" },
    "security_regression": { "type": "boolean" },
    "authorization_regression": { "type": "boolean" },
    "tenant_isolation_regression": { "type": "boolean" },
    "durability_regression": { "type": "boolean" },
    "staging_gates_pass": { "type": "boolean" },
    "manual_accessibility": { "$ref": "#/$defs/manualAccessibility" },
    "accessibility_findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/accessibilityFinding" }
    },
    "approver_receipt": { "$ref": "#/$defs/approverReceipt" },
    "action_count_receipts": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/actionCountReceipt" },
      "allOf": [
        { "contains": { "properties": { "id": { "const": "sign-in-inbox" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "invite-inbox" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "open-unread" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "directory-direct" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "directory-room" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "file-source-return" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "call-lobby-join" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "active-call-rejoin" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "you-profile" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "you-devices" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "you-notifications" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "you-settings" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "admin-entry" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "ops-entry" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "ordinary-recovery" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "instant_room_receipts": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/instantRoomReceipt" },
      "allOf": [
        { "contains": { "properties": { "id": { "const": "instant-room-host-start-untitled" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "instant-room-host-start-titled" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "instant-room-copy-link" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "instant-room-system-share" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "instant-room-qr" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "instant-room-guest-name-join" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "instant-room-roster-identity" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "instant-room-first-message" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "instant-room-host-reload" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "instant-room-guest-rejoin" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "instant-room-account-conversion-handoff" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "sessions": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/session" },
          {
            "oneOf": [
              { "$ref": "#/$defs/memberSession" },
              { "$ref": "#/$defs/adminSession" },
              { "$ref": "#/$defs/moderatorSession" },
              { "$ref": "#/$defs/complianceSession" },
              { "$ref": "#/$defs/operatorSession" }
            ]
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": 4 } },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["instant_room_receipts"],
        "properties": {
          "sessions": {
            "items": {
              "if": {
                "properties": { "cohort": { "const": "member" } },
                "required": ["cohort"]
              },
              "then": {
                "properties": {
                  "tasks": {
                    "minItems": 8,
                    "maxItems": 8,
                    "contains": {
                      "properties": { "id": { "const": "instant-room-first-contact" } },
                      "required": ["id"]
                    },
                    "minContains": 1,
                    "maxContains": 1
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "not": { "required": ["instant_room_receipts"] },
        "properties": {
          "sessions": {
            "items": {
              "allOf": [
                {
                  "properties": {
                    "tasks": {
                      "not": {
                        "contains": {
                          "properties": { "id": { "const": "instant-room-first-contact" } },
                          "required": ["id"]
                        }
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": { "cohort": { "const": "member" } },
                    "required": ["cohort"]
                  },
                  "then": {
                    "properties": {
                      "tasks": { "minItems": 7, "maxItems": 7 }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "manualAccessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wcag_2_2_a_aa_status", "assistive_technology_matrix_status", "open_a_aa_failures", "completed_on"],
      "properties": {
        "wcag_2_2_a_aa_status": { "enum": ["not_completed", "passed", "failed"] },
        "assistive_technology_matrix_status": { "enum": ["not_completed", "passed", "failed"] },
        "open_a_aa_failures": { "type": "integer", "minimum": 0 },
        "completed_on": { "type": ["string", "null"], "format": "date" }
      }
    },
    "accessibilityFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "standard", "severity", "status"],
      "properties": {
        "finding_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
        "standard": { "enum": ["WCAG 2.2 A", "WCAG 2.2 AA", "advisory"] },
        "severity": { "enum": ["critical", "serious", "moderate", "minor"] },
        "status": { "enum": ["open", "resolved"] }
      }
    },
    "approverReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approver_role", "approved_on", "evidence_reference"],
      "properties": {
        "status": { "enum": ["not_approved", "approved"] },
        "approver_role": { "const": "release_approver" },
        "approved_on": { "type": ["string", "null"], "format": "date" },
        "evidence_reference": { "type": ["string", "null"], "minLength": 1, "maxLength": 240 }
      }
    },
    "actionCountReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "participant_id",
        "baseline",
        "performed_on",
        "task_completed",
        "unassisted",
        "action_count",
        "maximum_actions",
        "justified_exception_actions"
      ],
      "properties": {
        "id": {
          "enum": [
            "sign-in-inbox",
            "invite-inbox",
            "open-unread",
            "directory-direct",
            "directory-room",
            "file-source-return",
            "call-lobby-join",
            "active-call-rejoin",
            "you-profile",
            "you-devices",
            "you-notifications",
            "you-settings",
            "admin-entry",
            "ops-entry",
            "ordinary-recovery"
          ]
        },
        "participant_id": { "type": "string", "pattern": "^P[0-9A-Za-z_-]+$" },
        "baseline": { "enum": ["daily_use", "end_to_end"] },
        "performed_on": { "type": "string", "format": "date" },
        "task_completed": { "type": "boolean" },
        "unassisted": { "type": "boolean" },
        "action_count": { "type": "integer", "minimum": 0 },
        "maximum_actions": { "type": "integer", "minimum": 1 },
        "justified_exception_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/justifiedActionException" }
        },
        "call_safety": { "$ref": "#/$defs/callSafety" }
      },
      "allOf": [
        {
          "if": { "properties": { "id": { "enum": ["sign-in-inbox", "invite-inbox"] } }, "required": ["id"] },
          "then": { "properties": { "baseline": { "const": "end_to_end" } } },
          "else": { "properties": { "baseline": { "const": "daily_use" } } }
        },
        {
          "if": { "properties": { "id": { "enum": ["directory-room", "call-lobby-join"] } }, "required": ["id"] },
          "then": { "properties": { "maximum_actions": { "const": 3 } } },
          "else": {
            "if": {
              "properties": {
                "id": {
                  "enum": [
                    "directory-direct",
                    "file-source-return",
                    "active-call-rejoin",
                    "admin-entry",
                    "ops-entry"
                  ]
                }
              },
              "required": ["id"]
            },
            "then": { "properties": { "maximum_actions": { "const": 2 } } },
            "else": { "properties": { "maximum_actions": { "const": 1 } } }
          }
        },
        {
          "if": { "properties": { "id": { "enum": ["call-lobby-join", "active-call-rejoin"] } }, "required": ["id"] },
          "then": { "required": ["call_safety"] },
          "else": { "not": { "required": ["call_safety"] } }
        },
        {
          "if": { "properties": { "id": { "const": "call-lobby-join" } }, "required": ["id"] },
          "then": {
            "properties": {
              "call_safety": {
                "properties": {
                  "lobby_action_count": { "const": 2 },
                  "join_or_start_action_count": { "const": 1 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "id": { "const": "active-call-rejoin" } }, "required": ["id"] },
          "then": {
            "properties": {
              "call_safety": {
                "properties": {
                  "lobby_action_count": { "const": 2 },
                  "join_or_start_action_count": { "const": 0 }
                }
              }
            }
          }
        }
      ]
    },
    "instantRoomReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "participant_id",
        "journey_role",
        "baseline",
        "performed_on",
        "task_completed",
        "unassisted",
        "action_count",
        "maximum_actions",
        "checks"
      ],
      "properties": {
        "id": {
          "enum": [
            "instant-room-host-start-untitled",
            "instant-room-host-start-titled",
            "instant-room-copy-link",
            "instant-room-system-share",
            "instant-room-qr",
            "instant-room-guest-name-join",
            "instant-room-roster-identity",
            "instant-room-first-message",
            "instant-room-host-reload",
            "instant-room-guest-rejoin",
            "instant-room-account-conversion-handoff"
          ]
        },
        "participant_id": { "type": "string", "pattern": "^P[0-9A-Za-z_-]+$" },
        "journey_role": { "enum": ["host", "guest"] },
        "baseline": { "enum": ["signed_out", "active_host", "invite_link", "active_room", "reentry", "active_guest"] },
        "performed_on": { "type": "string", "format": "date" },
        "task_completed": { "type": "boolean" },
        "unassisted": { "type": "boolean" },
        "action_count": { "type": "integer", "minimum": 0 },
        "maximum_actions": { "type": "integer", "minimum": 1 },
        "checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "host_display_name_entered",
              "host_name_visible_in_room",
              "room_title_omitted_without_blocking",
              "room_title_entered",
              "room_title_visible_in_room",
              "invite_link_copied",
              "copied_target_matches_invite",
              "system_share_or_fallback_opened",
              "shared_target_matches_invite",
              "qr_code_rendered",
              "qr_target_matches_invite",
              "guest_display_name_entered",
              "guest_name_visible_in_room",
              "host_and_guest_names_visible",
              "names_match_chosen_values",
              "host_and_guest_names_distinct",
              "message_visible_to_other_participant",
              "sender_name_matches_chosen_value",
              "same_room_rejoined",
              "host_control_restored",
              "host_name_restored",
              "guest_name_restored",
              "roster_presence_restored",
              "conversion_presented_as_optional",
              "anonymous_room_remained_usable",
              "workspace_address_presented",
              "portable_sign_in_link_presented"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "enum": [
                  "instant-room-host-start-untitled",
                  "instant-room-host-start-titled",
                  "instant-room-copy-link",
                  "instant-room-system-share",
                  "instant-room-qr",
                  "instant-room-host-reload"
                ]
              }
            },
            "required": ["id"]
          },
          "then": { "properties": { "journey_role": { "const": "host" } } },
          "else": { "properties": { "journey_role": { "const": "guest" } } }
        },
        {
          "if": { "properties": { "id": { "enum": ["instant-room-host-start-untitled", "instant-room-host-start-titled"] } }, "required": ["id"] },
          "then": { "properties": { "baseline": { "const": "signed_out" } } }
        },
        {
          "if": { "properties": { "id": { "enum": ["instant-room-copy-link", "instant-room-system-share", "instant-room-qr", "instant-room-host-reload"] } }, "required": ["id"] },
          "then": { "properties": { "baseline": { "const": "active_host" } } }
        },
        {
          "if": { "properties": { "id": { "const": "instant-room-guest-name-join" } }, "required": ["id"] },
          "then": { "properties": { "baseline": { "const": "invite_link" } } }
        },
        {
          "if": { "properties": { "id": { "enum": ["instant-room-roster-identity", "instant-room-first-message"] } }, "required": ["id"] },
          "then": { "properties": { "baseline": { "const": "active_room" } } }
        },
        {
          "if": { "properties": { "id": { "const": "instant-room-guest-rejoin" } }, "required": ["id"] },
          "then": { "properties": { "baseline": { "const": "reentry" } } }
        },
        {
          "if": { "properties": { "id": { "const": "instant-room-account-conversion-handoff" } }, "required": ["id"] },
          "then": {
            "properties": {
              "baseline": { "const": "active_guest" },
              "maximum_actions": { "const": 3 }
            }
          },
          "else": { "properties": { "maximum_actions": { "const": 1 } } }
        }
      ]
    },
    "justifiedActionException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "count"],
      "properties": {
        "reason": {
          "enum": [
            "identity_provider_step",
            "step_up_authentication",
            "reason_entry",
            "destructive_confirmation",
            "media_consent"
          ]
        },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "callSafety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "microphone_initially_off",
        "camera_initially_off",
        "lobby_observed_before_join",
        "lobby_action_count",
        "join_or_start_action_count"
      ],
      "properties": {
        "microphone_initially_off": { "type": "boolean" },
        "camera_initially_off": { "type": "boolean" },
        "lobby_observed_before_join": { "type": "boolean" },
        "lobby_action_count": { "type": "integer", "minimum": 0 },
        "join_or_start_action_count": { "type": "integer", "minimum": 0 }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_id",
        "cohort",
        "access_method",
        "mobile_first",
        "browser_name",
        "browser_version",
        "viewport_width_css_px",
        "viewport_height_css_px",
        "sus_responses",
        "sensitive_action_confidence",
        "tasks"
      ],
      "properties": {
        "participant_id": { "type": "string", "pattern": "^P[0-9A-Za-z_-]+$" },
        "cohort": { "enum": ["member", "admin", "moderator", "compliance", "operator"] },
        "access_method": { "enum": ["standard", "keyboard", "screen_reader", "zoom_high_contrast", "voice_touch"] },
        "mobile_first": { "type": "boolean" },
        "browser_name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "browser_version": { "type": "string", "minLength": 1, "maxLength": 80 },
        "viewport_width_css_px": { "type": "integer", "minimum": 240, "maximum": 10000 },
        "viewport_height_css_px": { "type": "integer", "minimum": 240, "maximum": 10000 },
        "sus_responses": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": { "type": "integer", "minimum": 1, "maximum": 5 }
        },
        "sensitive_action_confidence": { "type": "integer", "minimum": 1, "maximum": 5 },
        "tasks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/task" }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "critical", "outcome", "duration_seconds", "critical_errors", "backtracks", "facilitator_interventions", "seq", "unintended_destructive_action"],
      "properties": {
        "id": { "enum": ["invite-first-message", "channel-collaboration", "attachment-safety", "history-search", "send-recovery", "notification-control", "device-revocation", "instant-room-first-contact", "admin-access", "moderation-review", "audit-evidence", "ops-triage"] },
        "category": { "enum": ["invite", "routine", "public_room", "admin_safety", "ops_safety", "other"] },
        "critical": { "type": "boolean" },
        "outcome": { "enum": ["unassisted", "assisted", "failed"] },
        "duration_seconds": { "type": "number", "minimum": 0 },
        "critical_errors": { "type": "integer", "minimum": 0 },
        "backtracks": { "type": "integer", "minimum": 0 },
        "facilitator_interventions": { "type": "integer", "minimum": 0 },
        "seq": { "type": "number", "minimum": 1, "maximum": 7 },
        "unintended_destructive_action": { "type": "boolean" }
      },
      "allOf": [
        { "if": { "properties": { "id": { "const": "invite-first-message" } }, "required": ["id"] }, "then": { "properties": { "category": { "const": "invite" }, "critical": { "const": true } } } },
        { "if": { "properties": { "id": { "enum": ["channel-collaboration", "attachment-safety", "history-search", "send-recovery"] } }, "required": ["id"] }, "then": { "properties": { "category": { "const": "routine" }, "critical": { "const": true } } } },
        { "if": { "properties": { "id": { "const": "notification-control" } }, "required": ["id"] }, "then": { "properties": { "category": { "const": "other" }, "critical": { "const": false } } } },
        { "if": { "properties": { "id": { "const": "device-revocation" } }, "required": ["id"] }, "then": { "properties": { "category": { "const": "other" }, "critical": { "const": true } } } },
        { "if": { "properties": { "id": { "const": "instant-room-first-contact" } }, "required": ["id"] }, "then": { "properties": { "category": { "const": "public_room" }, "critical": { "const": true } } } },
        { "if": { "properties": { "id": { "enum": ["admin-access", "moderation-review"] } }, "required": ["id"] }, "then": { "properties": { "category": { "const": "admin_safety" }, "critical": { "const": true } } } },
        { "if": { "properties": { "id": { "const": "audit-evidence" } }, "required": ["id"] }, "then": { "properties": { "category": { "const": "admin_safety" }, "critical": { "const": false } } } },
        { "if": { "properties": { "id": { "const": "ops-triage" } }, "required": ["id"] }, "then": { "properties": { "category": { "const": "ops_safety" }, "critical": { "const": true } } } },
        { "if": { "properties": { "outcome": { "const": "unassisted" } }, "required": ["outcome"] }, "then": { "properties": { "critical_errors": { "const": 0 }, "facilitator_interventions": { "const": 0 } } } },
        { "if": { "properties": { "outcome": { "const": "assisted" } }, "required": ["outcome"] }, "then": { "properties": { "facilitator_interventions": { "minimum": 1 } } } }
      ]
    },
    "memberSession": {
      "properties": {
        "cohort": { "const": "member" },
        "tasks": {
          "minItems": 7,
          "maxItems": 8,
          "allOf": [
